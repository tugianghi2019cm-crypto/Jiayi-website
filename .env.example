# Jiayi Website — environment configuration template
#
# Copy this file to `.env.local` for local development and fill in
# real values there. `.env.local` is git-ignored and must never be
# committed. Real staging/production values belong ONLY in the
# hosting platform's environment variable configuration (e.g.
# Hostinger's Environment Variables panel) — never in this repo.
#
# See README.md for the full explanation of each configuration
# group, its security classification, and when it's actually
# required.

# --- Core (required in every environment) ---
# APP_ENV is the Jiayi *deployment* environment. It is distinct from
# Node's NODE_ENV runtime environment — a staging deployment
# legitimately runs with NODE_ENV=production and APP_ENV=staging at
# the same time. Allowed values: development | staging | production | test
APP_ENV=

# Canonical absolute URL of this deployment. Local development may use
# plain http; staging/production are expected to use https.
# Local example:      http://localhost:3000
# (Do not put the real staging or production URL in this file — set
# it in the hosting platform's environment configuration instead.)
APP_BASE_URL=

# --- Database (reserved for DB-001 — not implemented yet) ---
# SERVER SECRET. Leave unset until DB-001 is implemented.
DATABASE_URL=

# --- Google Identity (reserved for a future AUTH task — not implemented yet) ---
# GOOGLE_CLIENT_ID is PUBLIC-SAFE (not a secret) once configured.
# GOOGLE_CLIENT_SECRET is a SERVER SECRET, only needed if a future
# auth flow requires it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object Storage (vendor-neutral, reserved for a future task) ---
# STORAGE_PROVIDER / ENDPOINT / REGION / BUCKET are server config.
# STORAGE_ACCESS_KEY_ID and STORAGE_SECRET_ACCESS_KEY are SERVER SECRETS.
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Translation Provider (vendor-neutral, reserved for I18N-002) ---
# TRANSLATION_API_KEY is a SERVER SECRET.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=

# --- Web Push / VAPID (standards-based, reserved for later PUSH tasks) ---
# VAPID_PUBLIC_KEY is PUBLIC-SAFE. VAPID_PRIVATE_KEY is a SERVER
# SECRET. VAPID_SUBJECT is server config and must be a mailto: or
# https: contact URI. Do NOT generate or commit real VAPID keys here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

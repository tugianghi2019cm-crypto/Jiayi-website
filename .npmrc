# Works around a reproducible npm 10.x Arborist crash. Re-verified
# necessary as of this commit (DB-001 correction pass):
#
#   Without this file, `npm install`/`npm ci` fail deterministically
#   with npm 10.9.7 on Node v22.22.2:
#
#     npm error Cannot read properties of null (reading 'edgesOut')
#     TypeError: Cannot read properties of null (reading 'edgesOut')
#         at #loadPeerSet (@npmcli/arborist/lib/arborist/build-ideal-tree.js:1289:38)
#         at async Arborist.buildIdealTree (.../build-ideal-tree.js:181:7)
#         at async Arborist.reify (.../reify.js:133:5)
#
#   This happens purely during local dependency-graph resolution —
#   before any network fetch of Prisma's engine binaries — while npm
#   builds the optional peer set for @vitest/browser-playwright (an
#   optional peer of vitest, never installed itself) in combination
#   with the exact-pinned prisma/@prisma/*/vite versions this project
#   added. It reproduces on every clean install with no .npmrc, is
#   unrelated to any sandbox/network restriction, and does not change
#   which versions get installed for our own direct dependencies (all
#   exact-pinned in package.json) — it only relaxes strict peer
#   resolution for transitive peers, which is what avoids the crash.
#
# If a future dependency change removes vitest (or its optional
# @vitest/browser-playwright peer chain), re-test whether this is
# still required before removing it.
legacy-peer-deps=true
